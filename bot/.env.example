# --- Discord ---
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-app-id

# --- Lavalink node (run via docker: ghcr.io/lavalink-devs/lavalink:4) ---
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# --- Lovable Cloud / Supabase (copy from project .env, server-only keys) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# --- Bridge HTTP API (dashboard talks to this) ---
BRIDGE_PORT=8787
BRIDGE_SECRET=change-me-to-a-long-random-string
